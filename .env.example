# Copy to .env and fill in. Only GEMINI_API_KEY is required for a local demo.

# --- AI (Gemini) ---------------------------------------------------------
GEMINI_API_KEY=
# Harder reasoning steps (extraction, Skeptic, Composer)
GEMINI_MODEL_REASONING=gemini-3.6-flash
# Bulk / cheap steps (classification, reranking, question phrasing)
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# Smart search: gemini (default) | local (runs on this server, ~1.5 GB RAM, pip install .[local-search]) | off
EMBEDDING_PROVIDER=gemini
# Gemini free tier = 100 embeddings/minute; raise on a paid plan
EMBED_ITEMS_PER_MINUTE=90
# Strictest label whose text may go to an external embedding provider (team | restricted | confidential)
EMBED_EXTERNAL_MAX_LABEL=restricted
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
MODEL_CACHE_DIR=./.models
# Per-run safety limits
RUN_MAX_LLM_CALLS=400
RUN_MAX_TOKENS=2000000
# Calls per minute to each Gemini text model (raise on a paid tier)
LLM_RPM_REASONING=8
LLM_RPM_FAST=12
# Strictest label the agents may send to Gemini; confidential items never leave
LLM_EXTERNAL_MAX_LABEL=restricted
# Dates in claims ("since 20 Oct") use the team's time zone
TIMEZONE=Asia/Kolkata

# --- Database ------------------------------------------------------------
POSTGRES_USER=knowbridge
POSTGRES_PASSWORD=knowbridge
POSTGRES_DB=knowbridge
# Host ports (change if something else already uses them)
POSTGRES_PORT=5432
OPENFGA_PORT=8081
# Used when running the API outside Docker
# Server-to-server addresses use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first
# and every new connection waits for it to fail (0.2-2 s each).
DATABASE_URL=postgresql+psycopg://knowbridge:knowbridge@127.0.0.1:5432/knowbridge

# --- Permissions (Gatekeeper) -------------------------------------------
# openfga | local   (local = same rules enforced from Postgres tables)
AUTHZ_BACKEND=openfga
OPENFGA_API_URL=http://127.0.0.1:8081

# --- Auth ----------------------------------------------------------------
# Shared by web and api. Generate with: openssl rand -base64 48
API_JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only
# Auth.js secret for the web app
AUTH_SECRET=dev-only-auth-secret-change-me
AUTH_TRUST_HOST=true
# Optional OAuth providers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Lets you sign in as the Project Nimbus personas without OAuth. Turn off in production.
DEMO_MODE=true

# --- Web <-> API ---------------------------------------------------------
API_URL=http://127.0.0.1:8000
WEB_URL=http://localhost:3000

# --- Connectors ----------------------------------------------------------
# Fine-grained, read-only GitHub token (Contents, Issues, Pull requests, Metadata: read)
GITHUB_TOKEN=
# Encrypts saved connector credentials (Jira tokens). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=
# Allow Jira Data Center / self-hosted URLs (default: only *.atlassian.net)
JIRA_ALLOW_ANY_HOST=false
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
STORAGE_DIR=./storage

# --- Observability (optional) -------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LOG_LEVEL=INFO

# Agents' model: gemini (uses GEMINI_API_KEY above), or openai for any OpenAI-compatible API
# (ASI:One, Groq, OpenRouter, a local Ollama or vLLM server). Search embeddings stay on EMBEDDING_PROVIDER.
LLM_PROVIDER=gemini
# LLM_BASE_URL=https://api.asi1.ai/v1
# LLM_API_KEY=
# LLM_MODEL_REASONING=asi1-mini
# LLM_MODEL_FAST=asi1-mini
# Speed: calls per minute per model, and calls an agent may have in flight at once.
# Defaults suit Gemini's free tier; for ASI:One (200 calls / 15 min) use 60, 60 and 4.
# LLM_RPM_REASONING=8
# LLM_RPM_FAST=12
# LLM_PARALLEL=1

# Project chat (RAG). Its answers can come from a separate, smaller model: any OpenAI-compatible
# endpoint (a hosted Qwen, Groq, OpenRouter, or Ollama/vLLM on your own machine). Leave empty to
# use the agents' model above. The vector index itself uses the embedding settings further up.
# LLM_ASK_BASE_URL=https://openrouter.ai/api/v1
# LLM_ASK_API_KEY=
# LLM_ASK_MODEL=qwen/qwen3-4b
# LLM_ASK_RPM=30
# Only for a model on this machine or network: then confidential items may be sent to it.
# LLM_ASK_EXTERNAL=true
# How much retrieved text each answer gets, in tokens. Small models read best with less.
# RAG_CONTEXT_TOKENS=6000
# Guardrails: questions per person per minute / per day, and context exports per minute (0 = off).
# RAG_ASK_PER_MINUTE=20
# RAG_ASK_PER_DAY=400
# RAG_EXPORT_PER_MINUTE=30

# Local testing only: lets you "sign in as a teammate" with any email, to try the app as
# someone you added to a project. Ignored in production builds. Never set it on a live site.
DEV_LOGIN=false
