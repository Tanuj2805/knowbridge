# KnowBridge on a server. Copy to .env on the server and fill in every <...> value:
#   cp .env.production.example .env && nano .env
# Never commit .env. Generate each secret on the server with:  openssl rand -base64 48

# --- your address ---------------------------------------------------------------------------
DOMAIN=<your-domain, e.g. knowbridge.duckdns.org>
WEB_URL=https://<same domain as above>

# --- database (only reachable inside Docker) ------------------------------------------------------
POSTGRES_USER=knowbridge
POSTGRES_PASSWORD=<a long random password>
POSTGRES_DB=knowbridge

# --- secrets: new values, never the ones used on your laptop -----------------------------------------
API_JWT_SECRET=<openssl rand -base64 48>
AUTH_SECRET=<openssl rand -base64 48>
# Encrypts stored connector tokens (GitHub, Jira). Generate with:
#   docker run --rm python:3.12-slim python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SECRETS_KEY=<fernet key>

# --- sign in: at least one of these (see docs/DEPLOY-ORACLE.md, step 8) ---------------------------------
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- AI (use NEW keys: rotate the ones that were shared in chats) -----------------------------------
GEMINI_API_KEY=<new key>
GEMINI_API_KEY_BACKUP=
# To use ASI:One (or any OpenAI-compatible model) for the agents instead of Gemini:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.asi1.ai/v1
# LLM_API_KEY=<key>
# LLM_MODEL_REASONING=asi1-mini
# LLM_MODEL_FAST=asi1-mini
EMBEDDING_PROVIDER=gemini

# --- behaviour ------------------------------------------------------------------------------------
# "Load the demo" (Project Nimbus) on the projects page.
DEMO_MODE=true
AUTHZ_BACKEND=openfga
LOG_LEVEL=INFO
